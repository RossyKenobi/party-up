.tab-bar {
  position: absolute;
  bottom: calc(24px + env(safe-area-inset-bottom));
  left: 32px;
  right: 32px;
  height: 60px;
  background: rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
  display: flex;
  border-radius: 30px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  z-index: 999;
}

.tab-bar-item {
  flex: 1;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 16px;
  font-weight: 600;
  transition: opacity 0.2s;
}

.tab-bar-item:active {
  opacity: 0.7;
}
