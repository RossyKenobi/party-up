.week-view {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--bg-primary);
  overflow: hidden;
}

.week-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md) var(--space-md) var(--space-xs);
}

.month-label {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
}

.week-days-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  padding: var(--space-xs) var(--space-sm) 0;
}

.week-day-label {
  text-align: center;
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  font-weight: 500;
}

.week-dates-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  padding: 0 var(--space-sm);
  margin-bottom: var(--space-sm);
}

.week-date-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-xs) 0;
  border-radius: var(--radius-md);
}

.week-date-num {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  font-size: var(--font-base);
  font-weight: 500;
}

.week-date-cell.selected .week-date-num {
  background: var(--accent);
  color: var(--text-inverse);
  font-weight: 600;
}

.week-date-cell.today:not(.selected) .week-date-num {
  background: var(--accent-bg);
  color: var(--accent);
  font-weight: 600;
}

.event-dots {
  display: flex;
  gap: 3px;
  margin-top: 3px;
  min-height: 5px;
}

.event-dot {
  width: 5px;
  height: 5px;
  border-radius: var(--radius-full);
}

/* Timeline */
.day-timeline {
  flex: 1;
  height: 0;
  position: relative;
  background-color: var(--bg-card);
  border-top-left-radius: var(--radius-lg);
  border-top-right-radius: var(--radius-lg);
  box-shadow: 0 -4px 20px rgba(0,0,0,0.02);
}

.timeline-grid {
  position: relative;
  margin-left: 52px;
  border-left: 1px solid var(--divider);
}

.timeline-hour {
  height: 60px; /* var(--timeline-hour-height) */
  position: relative;
  border-bottom: 1px solid var(--divider);
}

.timeline-hour-label {
  position: absolute;
  left: -52px;
  top: -8px;
  width: 44px;
  text-align: right;
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  font-weight: 500;
}

.timeline-now-line {
  position: absolute;
  left: -8px;
  right: 0;
  height: 2px;
  background: var(--danger);
  z-index: 5;
}

.timeline-now-line::before {
  content: '';
  position: absolute;
  left: -4px;
  top: -4px;
  width: 10px;
  height: 10px;
  border-radius: var(--radius-full);
  background: var(--danger);
}

.timeline-event {
  position: absolute;
  left: var(--space-sm);
  right: var(--space-sm);
  border-radius: var(--radius-sm);
  padding: var(--space-xs) var(--space-sm);
  overflow: hidden;
  z-index: 3;
}

.event-title {
  font-size: var(--font-xs);
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.event-time {
  font-size: 10px;
  margin-top: 2px;
}
