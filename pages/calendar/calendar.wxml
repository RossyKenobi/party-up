<!--pages/calendar/calendar.wxml-->
<view class="week-view">
  <view class="week-header">
    <text class="month-label" bindtap="switchToMonth">{{monthName}} {{displayYear}}</text>
    <view class="view-toggle" style="display:flex; align-items:center; gap:8px;">
      <view class="btn btn-secondary" style="padding: 4px 16px; font-size: 14px; min-width: 60px;" bindtap="goToday">今日</view>
      <view class="btn btn-primary" style="padding: 4px 16px; font-size: 14px; min-width: 60px;" bindtap="goCreate">＋</view>
    </view>
  </view>

  <view class="week-days-row">
    <text class="week-day-label" wx:for="{{dayNamesShort}}" wx:key="*this">{{item}}</text>
  </view>

  <view class="week-dates-row">
    <view class="week-date-cell {{item.isToday ? 'today' : ''}} {{item.isSelected ? 'selected' : ''}}" 
          wx:for="{{weekDates}}" wx:key="date" data-date="{{item.dateStr}}" bindtap="selectDate">
      <view class="week-date-num">{{item.dateNum}}</view>
      <view class="event-dots">
        <view class="event-dot" wx:for="{{item.dots}}" wx:for-item="dot" wx:key="*this" style="background:{{dot}}"></view>
      </view>
    </view>
  </view>

  <scroll-view class="day-timeline" scroll-y="true" scroll-top="{{scrollTop}}">
    <view class="timeline-grid" style="height:{{24 * hourHeight}}px; margin-top: 10px; margin-bottom: 10px;">
      <view class="timeline-hour" wx:for="{{hours}}" wx:key="*this">
        <text class="timeline-hour-label">{{item}}:00</text>
      </view>
      <view style="position: absolute; top: {{24 * hourHeight}}px; width: 100%;">
        <text class="timeline-hour-label">24:00</text>
      </view>

      <view wx:if="{{isToday}}" class="timeline-now-line" style="top:{{nowLineTop}}px"></view>

      <view class="timeline-event" wx:for="{{eventsForSelected}}" wx:key="id" 
            style="top:{{item.top}}px; height:{{item.height}}px; background-color:{{item.bgColor}}; border-left:3px solid {{item.color}}; color:{{item.color}};"
            data-id="{{item.id}}" bindtap="goDetail">
        <view class="event-title">{{item.emoji}} {{item.title}}</view>
        <view class="event-time" style="opacity:0.7">{{item.timeStr}}</view>
      </view>
    </view>
  </scroll-view>
</view>
