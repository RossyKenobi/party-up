.splash-container {
  width: 100vw;
  height: 100vh;
  position: relative;
  overflow: hidden;
  background-color: #f8f6f4;
}

.splash-bg {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
}

.skip-btn {
  position: absolute;
  bottom: 80rpx;
  right: 60rpx;
  z-index: 10;
  padding: 12rpx 30rpx;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(8px);
  border-radius: 40rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
