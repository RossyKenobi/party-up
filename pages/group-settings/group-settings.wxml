<!--pages/group-settings/group-settings.wxml-->
<view class="container fade-in" wx:if="{{group}}">
  <!-- Section 1: Member Management -->
  <view class="card section-card">
    <view class="section-title">
      成员管理
      <text class="member-count">({{members.length}}/{{group.maxMembers}})</text>
    </view>
    <view class="member-list">
      <view
        class="member-row {{index === members.length - 1 ? 'no-border' : ''}}"
        wx:for="{{members}}"
        wx:key="userId"
      >
        <view class="member-avatar" style="background:{{item.avatarColor}}">
          <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" class="avatar-img" />
          <text wx:else>{{item.initial}}</text>
        </view>
        <view class="member-info">
          <text class="member-name">{{item.nickname}}</text>
          <text wx:if="{{item.isCreator}}" class="creator-badge">(组长)</text>
        </view>
        <view
          wx:if="{{isCreator && !item.isCreator}}"
          class="kick-btn"
          data-userid="{{item.userId}}"
          data-nickname="{{item.nickname}}"
          bindtap="handleKick"
        >移出</view>
      </view>
    </view>
  </view>

  <!-- Section 2: Group Settings -->
  <view class="card section-card">
    <view class="section-title">小组设置</view>
    <view class="setting-row" wx:if="{{isCreator}}">
      <text class="setting-label">允许新成员加入</text>
      <switch
        checked="{{group.allowNewMembers}}"
        data-field="allowNewMembers"
        bindchange="handleToggle"
        color="#c4a381"
      />
    </view>
    <view class="setting-row" wx:if="{{isCreator}}">
      <text class="setting-label">允许投票</text>
      <switch
        checked="{{group.allowVoting}}"
        data-field="allowVoting"
        bindchange="handleToggle"
        color="#c4a381"
      />
    </view>
    <view class="setting-row" wx:if="{{isCreator}}">
      <text class="setting-label">匿名投票</text>
      <switch
        checked="{{group.isAnonymous}}"
        data-field="isAnonymous"
        bindchange="handleToggle"
        color="#c4a381"
      />
    </view>
    <view class="setting-row {{hasDeadline ? 'no-border' : ''}}" wx:if="{{isCreator}}">
      <text class="setting-label">投票截止时间</text>
      <switch checked="{{hasDeadline}}" bindchange="onDeadlineSwitchChange" color="#d3a778"/>
    </view>

    <view class="deadline-pickers" wx:if="{{isCreator && hasDeadline}}">
      <picker mode="date" value="{{customDate}}" start="{{today}}" bindchange="onCustomDate">
        <view class="picker-btn {{customDate ? 'active-picker' : ''}}">{{customDate || '选择日期'}}</view>
      </picker>
      <picker mode="time" value="{{customTime}}" bindchange="onCustomTime">
        <view class="picker-btn {{customTime ? 'active-picker' : ''}}">{{customTime || '选择时间'}}</view>
      </picker>
    </view>

    <view class="setting-row" wx:if="{{isCreator}}">
      <text class="setting-label">允许成员发起活动</text>
      <switch
        checked="{{group.allowMemberEvents !== false}}"
        data-field="allowMemberEvents"
        bindchange="handleToggle"
        color="#c4a381"
      />
    </view>
  </view>

  <!-- Leave Group (non-creator) -->
  <view class="card action-card" wx:if="{{!isCreator}}" bindtap="handleLeave">
    退出小组
  </view>

  <!-- Voting Control (creator only) -->
  <view class="card action-card voting-control-card" wx:if="{{isCreator}}" bindtap="handleToggleVotingClosed">
    <text>{{group.votingClosed ? '开启投票' : '结束投票'}}</text>
  </view>

  <!-- Dissolve Group (creator only) -->
  <view class="card action-card dissolve-card" wx:if="{{isCreator}}" bindtap="handleDissolve">
    解散小组
  </view>
</view>

<view wx:else class="empty-state">加载中...</view>
