/* pages/group-settings/group-settings.wxss */
.container {
  padding: var(--space-md);
}

.section-card {
  margin-bottom: var(--space-md);
}

.section-title {
  font-size: var(--font-md);
  font-weight: 700;
  margin-bottom: var(--space-md);
  color: var(--text-primary);
}

.member-count {
  color: var(--text-tertiary);
  font-weight: 400;
}

/* Member rows */
.member-row {
  display: flex;
  align-items: center;
  padding: var(--space-md) 0;
  border-bottom: 1px solid var(--divider);
}

.member-row.no-border {
  border-bottom: none;
}

.member-avatar {
  width: 24px;
  height: 24px;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-inverse);
  font-weight: 700;
  font-size: var(--font-xs);
  flex-shrink: 0;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.member-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  margin-left: var(--space-sm);
}

.member-name {
  font-size: var(--font-base);
  color: var(--text-primary);
}

.creator-badge {
  font-size: var(--font-xs);
  color: var(--accent);
  font-weight: 600;
}

.kick-btn {
  font-size: var(--font-sm);
  color: var(--danger);
  flex-shrink: 0;
}

/* Setting rows */
.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0; /* Reduced vertical padding */
  border-bottom: 1px solid var(--divider);
}

.setting-row.no-border {
  border-bottom: none;
}

.setting-label {
  font-size: var(--font-base);
  color: var(--text-primary);
}

/* Deadline picker */
.deadline-value {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-right: 8px; /* Slightly right shifted to align with button */
}

.arrow {
  color: var(--text-tertiary);
  font-family: Arial, sans-serif;
  margin-top: 1px;
}

.deadline-text {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.deadline-arrow {
  font-size: var(--font-md);
  color: var(--text-tertiary);
  margin-left: 2px;
}

.deadline-pickers {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-bottom: var(--space-xs); /* Reduce bottom margin */
  justify-content: flex-end;
  align-items: center;
}

.picker-btn {
  padding: 6px 12px;
  background: var(--bg-secondary);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  color: var(--text-secondary);
  text-align: center;
}

.picker-actions {
  display: flex;
  gap: 8px;
  margin-left: auto;
}

.cancel-btn {
  background: var(--bg-card);
  color: var(--text-primary);
  border: 1px solid var(--border);
}

.confirm-btn {
  background: var(--accent);
  color: var(--text-inverse);
  font-weight: 600;
  border: 1px solid var(--accent);
}

/* Action cards */
.action-card {
  text-align: center;
  padding: var(--space-md) 0;
  color: var(--text-secondary);
  font-size: var(--font-base);
  font-weight: 600;
  margin-bottom: var(--space-md);
}

.action-card:active {
  opacity: 0.7;
}

.dissolve-card {
  color: var(--danger);
}

/* Empty state */
.empty-state {
  padding: 100px 0;
  text-align: center;
  color: var(--text-tertiary);
}
