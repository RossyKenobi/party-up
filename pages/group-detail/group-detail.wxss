/* pages/group-detail/group-detail.wxss */
.container {
  padding: var(--space-md);
  padding-bottom: var(--space-2xl);
}

/* Header Info Bar */
.header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm) 0;
  margin-bottom: var(--space-md);
  border-bottom: 1px solid var(--divider);
}

.header-left {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
}

.header-meta {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.header-right {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.settings-btn {
  padding: var(--space-xs);
  display: flex;
  align-items: center;
  justify-content: center;
}

.settings-icon {
  width: 24px;
  height: 24px;
}

.share-btn {
  background: none;
  border: none;
  padding: var(--space-xs);
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-btn::after {
  border: none;
}

.share-icon {
  width: 24px;
  height: 24px;
}

/* Section */
.section {
  margin-bottom: var(--space-lg);
}

.section-title {
  font-size: var(--font-md);
  font-weight: 700;
  margin-bottom: var(--space-md);
}

/* Places List */
.places-list {
  display: flex;
  flex-direction: column;
}

.place-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm) 0;
  border-bottom: 1px solid var(--divider);
}

.place-content {
  flex: 1;
  min-width: 0;
  margin-right: var(--space-sm);
}

.place-text {
  font-size: var(--font-base);
  color: var(--text-primary);
  display: block;
  word-break: break-all;
}



/* Vote Button */
.vote-btn {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  padding: var(--space-xs) var(--space-sm);
  flex-shrink: 0;
}

.vote-icon-img {
  width: 24px;
  height: 24px;
  transition: transform 0.15s ease;
}

.vote-btn:active .vote-icon-img {
  transform: scale(1.3);
}

.vote-count {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  min-width: 16px;
  text-align: center;
}

.vote-disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* Add Place Row */
.add-place-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-sm);
  margin-top: var(--space-lg);
  background: var(--bg-secondary);
  border-radius: var(--radius-sm);
}

.add-place-input {
  flex: 1;
  font-size: var(--font-sm);
  padding: var(--space-xs) 0;
}

.add-place-btn {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-inverse);
  background: var(--accent);
  padding: var(--space-xs) var(--space-md);
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

/* Voting Closed Notice */
.voting-closed-notice {
  text-align: center;
  padding: var(--space-md);
  color: var(--text-tertiary);
  font-size: var(--font-sm);
}

/* Chart Section */
.chart-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.chart-row {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.chart-label {
  font-size: var(--font-sm);
  color: var(--text-primary);
  font-weight: 500;
}

.chart-bar-wrap {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.chart-bar-bg {
  flex: 1;
  height: 24px;
  background: var(--bg-secondary);
  border-radius: 12px;
  overflow: hidden;
}

.chart-bar-fill {
  height: 100%;
  border-radius: 12px;
  transition: width 0.6s ease;
}

.bar-top {
  background: var(--accent);
}

.bar-normal {
  background: var(--primary);
}

.chart-stat {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  white-space: nowrap;
  flex-shrink: 0;
  width: 80px;
  text-align: left;
}

/* Chart Voters */
.chart-voters {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 6px;
  padding-left: 2px;
}

.chart-voter-avatar {
  width: 20px;
  height: 20px;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1px solid rgba(0,0,0,0.05);
}

.chart-voter-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.chart-voter-text {
  font-size: 10px;
  color: var(--text-inverse);
  font-weight: 600;
}

/* Empty State */
.empty-state {
  padding: 100px 0;
  text-align: center;
  color: var(--text-tertiary);
}
