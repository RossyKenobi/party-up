/* pages/group-detail/group-detail.wxss */
.container {
  padding: var(--space-md);
  padding-bottom: var(--space-2xl);
}

/* Header Info Bar */
.header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm) 0;
  margin-bottom: var(--space-md);
  border-bottom: 1px solid var(--divider);
}

.header-left {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  flex-wrap: wrap;
}

.header-meta {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.deadline-countdown {
  font-size: var(--font-sm);
  color: var(--accent);
}

.deadline-expired {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

.header-right {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.settings-btn {
  padding: var(--space-xs);
  display: flex;
  align-items: center;
  justify-content: center;
}

.settings-icon {
  width: 24px;
  height: 24px;
}

.share-btn {
  background: none;
  border: none;
  padding: var(--space-xs);
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-btn::after {
  border: none;
}

.share-icon {
  width: 24px;
  height: 24px;
}

/* Inline Avatar Wall */
.member-wall-inline {
  display: flex;
  margin-left: var(--space-sm);
}

.wall-avatar-inline {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 1px solid var(--bg-card);
  margin-left: -6px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.wall-avatar-inline:first-child {
  margin-left: 0;
}

.wall-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.wall-avatar-text {
  font-size: 8px;
  color: var(--text-inverse);
  font-weight: 700;
}

/* Main Section */
.section {
  margin-bottom: var(--space-lg);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-md);
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 700;
}

.edit-btn {
  font-size: var(--font-sm);
  color: var(--accent);
  font-weight: 600;
  padding: var(--space-xs) var(--space-sm);
}

.edit-actions-header {
  display: flex;
  align-items: center;
  gap: 8px;
}

.cancel-btn-header {
  color: var(--text-tertiary);
}

/* Places List */
.places-list {
  display: flex;
  flex-direction: column;
}

.place-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm) 0;
  border-bottom: 1px solid var(--divider);
}

.place-content {
  flex: 1;
  min-width: 0;
  margin-right: var(--space-sm);
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.place-text {
  font-size: var(--font-base);
  color: var(--text-primary);
  word-break: break-all;
}

.comment-toggle {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  flex-shrink: 0;
}

/* Vote Button */
.vote-btn {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  padding: var(--space-xs) var(--space-sm);
  flex-shrink: 0;
}

.vote-icon-img {
  width: 24px;
  height: 24px;
  transition: transform 0.15s ease;
}

.vote-btn:active .vote-icon-img {
  transform: scale(1.3);
}

.vote-count {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  min-width: 16px;
  text-align: center;
}

.vote-disabled {
  opacity: 0.4;
  color: var(--text-secondary);
}

.edit-actions {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin-right: var(--space-sm);
  min-height: 32px; /* Prevents row shrinking in edit mode */
}

.edit-icon {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-primary);
  border-radius: 50%;
  color: var(--text-secondary);
  font-size: var(--font-md);
}

.delete-icon {
  background: transparent;
  color: #ff4d4f;
  font-size: 20px;
  width: auto;
}

.drag-icon {
  font-size: 20px;
  cursor: grab;
}

/* Comment Section */
.comment-section {
  padding: 12px 16px;
  background: var(--bg-secondary);
  border-radius: var(--radius-md);
  margin: var(--space-sm) 0;
}

.comment-item {
  display: flex;
  align-items: flex-start;
  gap: var(--space-xs);
  margin-bottom: var(--space-sm);
}

.comment-avatar {
  width: 24px;
  height: 24px;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.comment-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.comment-avatar-text {
  font-size: 10px;
  color: var(--text-inverse);
  font-weight: 600;
}

.comment-body {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: var(--space-xs);
}

.comment-author {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  flex-shrink: 0;
}

.comment-text {
  font-size: var(--font-sm);
  color: var(--text-primary);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.comment-delete {
  font-size: var(--font-base);
  color: var(--text-tertiary);
  padding: 0 var(--space-xs);
  flex-shrink: 0;
  line-height: 1;
}

.comment-input-row {
  display: flex;
  align-items: center;
  gap: 12px;
}

.comment-input {
  flex: 1;
  font-size: var(--font-sm);
  padding: 8px 16px;
  background: var(--bg-card);
  border-radius: var(--radius-full);
  min-width: 0;
  box-sizing: border-box;
  width: 100%;
}

.comment-send {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--accent);
  padding: 10px 16px;
}

/* Add Place Row */
.add-place-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-sm);
  margin-top: var(--space-lg);
  background: var(--bg-secondary);
  border-radius: var(--radius-sm);
}

.add-place-input {
  flex: 1;
  font-size: var(--font-sm);
  padding: var(--space-xs) 0;
}

.add-place-btn {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-inverse);
  background: var(--accent);
  padding: var(--space-xs) var(--space-md);
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

/* Voting Closed Notice */
.voting-closed-notice {
  text-align: center;
  padding: var(--space-md);
  color: var(--text-tertiary);
  font-size: var(--font-sm);
}

/* Chart Section */
.chart-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.chart-row {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-xs);
  border-radius: var(--radius-sm);
  transition: background 0.3s ease;
}

.chart-winner {
  background: var(--accent-bg);
}

.chart-row-header {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.chart-label {
  font-size: var(--font-sm);
  color: var(--text-primary);
  font-weight: 500;
}

.chart-bar-wrap {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.chart-bar-bg {
  flex: 1;
  height: 24px;
  background: var(--bg-secondary);
  border-radius: 12px;
  overflow: hidden;
}

.chart-bar-fill {
  height: 100%;
  border-radius: 12px;
  transition: width 0.6s ease;
}

.bar-top {
  background: var(--accent);
}

.bar-normal {
  background: var(--primary);
}

.chart-stat {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  white-space: nowrap;
  flex-shrink: 0;
  width: 80px;
  text-align: left;
}

/* Chart Voters */
.chart-voters {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4px;
}

.chart-voter-avatar {
  width: 20px;
  height: 20px;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1px solid rgba(0,0,0,0.05);
  overflow: hidden;
}

.chart-voter-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.chart-voter-text {
  font-size: 10px;
  color: var(--text-inverse);
  font-weight: 600;
}

/* Empty State */
.empty-state {
  padding: 100px 0;
  text-align: center;
  color: var(--text-tertiary);
}
