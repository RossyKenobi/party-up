<!--pages/group-detail/group-detail.wxml-->
<wxs module="drag" src="./drag.wxs"></wxs>
<view class="container fade-in {{isEditMode ? 'edit-mode' : ''}}" wx:if="{{group}}">
  <!-- Header Info Bar -->
  <view class="header-bar">
    <view class="header-left">
      <text class="header-meta">👤 {{group.memberIds.length}}/{{group.maxMembers}}</text>
      <text class="header-meta">· {{group.isAnonymous ? '匿名投票' : '实名投票'}}</text>
      <view class="member-wall-inline" wx:if="{{group.members.length > 0}}">
        <view class="wall-avatar-inline" wx:for="{{group.members}}" wx:key="userId" style="background: {{item.avatarColor || '#e8eceb'}}">
          <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" class="wall-avatar-img"/>
          <text wx:else class="wall-avatar-text">{{item.nickname[0]}}</text>
        </view>
      </view>
      <text class="deadline-countdown" wx:if="{{deadline && !isExpired}}">· ⏰ {{countdownText}}</text>
      <text class="deadline-expired" wx:if="{{isExpired}}">· 已截止</text>
    </view>
    <view class="header-right">
      <view class="settings-btn" wx:if="{{isMember && (isCreator || group.allowMemberEvents !== false)}}" bindtap="handleCreateGroupEvent">
        <image src="/assets/calendar-icon.svg" class="settings-icon" mode="aspectFit" />
      </view>
      <view class="settings-btn" wx:if="{{isCreator}}" bindtap="handleGoSettings">
        <image src="/assets/settings-icon.svg" class="settings-icon" mode="aspectFit" />
      </view>
      <button class="share-btn" bindtap="handleGeneratePoster">
        <image src="/assets/share-icon.svg" class="share-icon" mode="aspectFit" />
      </button>
    </view>
  </view>

  <!-- Upcoming Events -->
  <view class="section card" wx:if="{{upcomingEvents.length > 0}}">
    <view class="section-title">📅 活动安排 ({{upcomingEvents.length}})</view>
    <view class="event-item" wx:for="{{upcomingEvents}}" wx:key="id" data-event="{{item}}" bindtap="showEventDetail">
      <view class="event-item-left">
        <text class="event-emoji">{{item.emoji}}</text>
        <view class="event-item-info">
          <text class="event-item-title">{{item.title}}</text>
          <text class="event-item-time">{{item.displayTime}}</text>
        </view>
      </view>
      <text class="event-item-location" wx:if="{{item.location}}">📍 {{item.location}}</text>
    </view>
  </view>

  <!-- Places Section -->
  <view class="section">
    <view class="section-header">
      <view class="section-title">📍 目的地 ({{places.length}})</view>
      <view class="edit-actions-header" wx:if="{{isCreator}}">
        <view class="edit-btn cancel-btn-header" wx:if="{{isEditMode}}" bindtap="toggleEditMode">Cancel</view>
        <view class="edit-btn" bindtap="toggleEditMode">{{isEditMode ? 'Done' : 'Edit'}}</view>
      </view>
    </view>

    <view class="places-list">
      <view class="place-item-wrapper" wx:for="{{places}}" wx:key="id" data-index="{{index}}">
        <view
          class="place-item {{item.isWinner ? 'place-winner' : ''}}"
          data-place-id="{{item.id}}"
          data-index="{{index}}"
          bindlongpress="handlePlaceLongPress"
          bindtap="{{group.votingClosed && isCreator ? 'handleToggleWinner' : ''}}"
        >
          <view class="place-content">
            <text class="place-text">{{item.text}}</text>
            <view class="comment-toggle" data-place-id="{{item.id}}" catchtap="toggleComments">
              💬 {{item.commentCount > 0 ? item.commentCount : ''}}
            </view>
          </view>
          
          <!-- Vote Button -->
          <view wx:if="{{!isEditMode}}" class="vote-btn {{effectiveAllowVoting ? '' : 'vote-disabled'}} {{item.voted ? 'voted' : ''}}" catchtap="handleVote" data-place-id="{{item.id}}" data-index="{{index}}">
            <image class="vote-icon-img" src="{{item.voted ? '/assets/heart-filled.svg' : '/assets/heart-outline.svg'}}" mode="aspectFit" />
            <text class="vote-count">{{item.voteCount}}</text>
          </view>
          
          <!-- Edit Actions -->
          <view wx:else class="edit-actions">
            <view class="edit-icon drag-icon" catchtouchstart="{{drag.touchStart}}" catchtouchmove="{{drag.touchMove}}" catchtouchend="{{drag.touchEnd}}" data-index="{{index}}" data-max="{{places.length - 1}}">≡</view>
            <view class="edit-icon delete-icon" catchtap="handleDeletePlaceIcon" data-place-id="{{item.id}}">✕</view>
          </view>
        </view>

        <!-- Expanded Comment Section -->
        <view class="comment-section" wx:if="{{expandedPlaceId === item.id}}">
          <view class="comment-item" wx:for="{{item.comments}}" wx:key="id" wx:for-item="comment">
            <view class="comment-avatar" style="background: {{comment.avatarColor || '#e8eceb'}}">
              <image wx:if="{{comment.avatarUrl}}" src="{{comment.avatarUrl}}" class="comment-avatar-img"/>
              <text wx:else class="comment-avatar-text">{{comment.nickname[0]}}</text>
            </view>
            <view class="comment-body">
              <text class="comment-author">{{comment.nickname}}</text>
              <text class="comment-text">{{comment.text}}</text>
            </view>
            <view
              wx:if="{{comment.userId === currentUserId || isCreator}}"
              class="comment-delete"
              data-comment-id="{{comment.id}}"
              catchtap="handleDeleteComment"
            >×</view>
          </view>

          <!-- Comment Input -->
          <view class="comment-input-row" wx:if="{{isMember}}">
            <input
              class="comment-input"
              placeholder="Add Comment"
              value="{{commentText}}"
              bindinput="onCommentInput"
              cursor-spacing="20"
            />
            <view class="comment-send" catchtap="submitComment" data-place-id="{{item.id}}">Send</view>
          </view>
        </view>
      </view>
    </view>

    <!-- Add Place Input -->
    <view class="add-place-row" wx:if="{{effectiveAllowVoting && isMember && !group.votingClosed}}">
      <input
        class="add-place-input"
        placeholder="添加新地点..."
        value="{{newPlaceText}}"
        bindinput="onNewPlaceInput"
        bindconfirm="handleAddPlace"
        confirm-type="done"
      />
      <view class="add-place-btn" bindtap="handleAddPlace">添加</view>
    </view>
    <view class="voting-closed-notice" wx:if="{{!effectiveAllowVoting}}">
      <text>{{group.votingClosed ? '投票已结束' : (isExpired ? '投票已截止' : '投票已关闭')}}</text>
    </view>
  </view>

  <!-- Statistics Chart Section -->
  <view class="section card" wx:if="{{chartPlaces.length > 0}}">
    <view class="section-title">📊 投票统计</view>

    <view class="chart-list">
      <view class="chart-row" wx:for="{{chartPlaces}}" wx:key="id">
        <view class="chart-row-header">
          <text class="chart-label">{{item.text}}</text>
          <view class="chart-voters" wx:if="{{!group.isAnonymous && item.votersInfo && item.votersInfo.length > 0}}">
            <view class="chart-voter-avatar" wx:for="{{item.votersInfo}}" wx:key="userId" wx:for-item="voter" style="background: {{voter.avatarColor || '#e8eceb'}}">
              <image wx:if="{{voter.avatarUrl}}" src="{{voter.avatarUrl}}" class="chart-voter-img"/>
              <text wx:else class="chart-voter-text">{{voter.nickname[0]}}</text>
            </view>
          </view>
        </view>
        <view class="chart-bar-wrap">
          <view class="chart-bar-bg">
            <view
              class="chart-bar-fill"
              style="width: {{item.barWidth}}; background: var(--accent); opacity: {{item.opacity}}"
            ></view>
          </view>
          <text class="chart-stat">{{item.voteCount}}票 ({{item.pct}}%)</text>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- Loading / Empty State -->
<view wx:if="{{loading}}" class="empty-state">加载中...</view>
<view wx:elif="{{!group}}" class="empty-state">小组不存在</view>

<!-- Hidden Canvas for Poster Generation -->
<canvas type="2d" id="posterCanvas" style="position: fixed; left: -9999px; width: 600px; height: 900px;"></canvas>

<!-- Poster Popup -->
<view class="poster-overlay fade-in" wx:if="{{showPosterPopup}}" catchtouchmove="true">
  <view class="poster-content">
    <image src="{{posterTempFilePath}}" mode="widthFix" class="poster-image"></image>
    <view class="poster-actions">
      <view class="poster-action-btn close-btn" bindtap="closePosterPopup">
        <image src="/assets/close-icon.svg" style="width: 36rpx; height: 36rpx;" />
      </view>
      <view class="poster-action-btn save-btn" bindtap="savePosterToAlbum">
        <image src="/assets/download-icon.svg" style="width: 36rpx; height: 36rpx;" />
      </view>
      <button class="poster-action-btn share-action-btn" open-type="share">
        <image src="/assets/share-icon-thin.svg" style="width: 36rpx; height: 36rpx;" />
      </button>
    </view>
  </view>
</view>

<!-- Event Detail Popup -->
<view class="poster-overlay fade-in" wx:if="{{showEventPopup}}" bindtap="hideEventPopup">
  <view class="event-popup card" catchtap>
    <view class="event-popup-header">
      <view class="event-popup-title-wrap">
        <text class="event-popup-title">{{selectedEvent.title}}</text>
        <image src="/assets/edit-icon.svg" class="event-popup-action-icon" wx:if="{{selectedEvent.creatorId === currentUserId}}" catchtap="handleEditEvent" />
      </view>
      <image src="/assets/delete-icon.svg" class="event-popup-action-icon" wx:if="{{selectedEvent.creatorId === currentUserId}}" catchtap="handleDeleteEvent" />
    </view>
    <view class="event-popup-row">
      <text class="event-popup-label">时间</text>
      <text class="event-popup-value">{{selectedEvent.displayTime}}</text>
    </view>
    <view class="event-popup-row" wx:if="{{selectedEvent.location}}">
      <text class="event-popup-label">地点</text>
      <text class="event-popup-value">📍 {{selectedEvent.location}}</text>
    </view>
    <view class="event-popup-row participant-row">
      <text class="event-popup-label">参与者 ({{selectedEvent.participants.length}})</text>
      <text class="event-popup-value participant-names">{{selectedEvent.participantsStr}}</text>
    </view>
  </view>
</view>
