<!--pages/detail/detail.wxml-->
<view class="container fade-in" wx:if="{{event}}">
  <view class="card event-header-card">
    <view class="event-title">
      <text style="margin-right:8px">{{category.emoji}}</text>{{event.title}}
    </view>
    <view class="event-time-lg">
      {{dateStr}} {{timeStr}}
    </view>
    <view class="event-location" wx:if="{{event.location}}">
      📍 {{event.location}}
    </view>
  </view>

  <view class="card participants-card">
    <view class="card-title">参与者 ({{participants.length}})</view>
    <view class="participants-list">
      <view class="participant-item" wx:for="{{participants}}" wx:key="id">
        <view class="p-avatar" style="background:{{item.avatarColor}}">
          <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" style="width:100%;height:100%;border-radius:50%;" />
          <text wx:else>{{item.initial}}</text>
        </view>
        <view class="p-name">{{item.nickname}}</view>
        <view class="p-badge" wx:if="{{item.id === event.creatorId}}">创建者</view>
      </view>
    </view>
  </view>

  <view class="actions-panel">
    <button class="btn btn-primary" style="flex:1" wx:if="{{!hasJoined && !isPast}}" bindtap="handleJoin">加入活动</button>
    <button class="btn btn-primary" open-type="share" style="flex:1" wx:if="{{hasJoined && !isPast}}">邀请好友</button>
    <button class="btn btn-secondary" style="flex:1" wx:if="{{hasJoined && !isCreator && !isPast}}" bindtap="handleLeave">退出</button>
    <button class="btn btn-secondary" style="flex:1" wx:if="{{isCreator && !isPast}}" bindtap="handleEdit">编辑</button>
    <button class="btn btn-secondary" style="flex:1; color:var(--danger)" wx:if="{{isCreator || isAdmin}}" bindtap="handleDelete">删除</button>
  </view>
</view>
<view wx:else class="empty-state">
  加载中或活动不存在...
</view>
